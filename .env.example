# ---- フロントエンド（ビルド時に埋め込まれます。秘密の値は入れないでください） ----
# ランキングAPIの接続先。未設定ならランキングは「未接続」表示でローカル版として動きます。
#   同じサーバーから配信する場合: VITE_API_BASE=/
#   別ドメインのAPI:           VITE_API_BASE=https://api.example.com
VITE_API_BASE=
# Xの投稿文に付ける公開ゲームURL（未公開なら空のまま。存在しないURLを入れない）
VITE_PUBLIC_GAME_URL=
# サブパスで公開する場合（GitHub Pages: /リポジトリ名/）
VITE_BASE=/

# ---- ランキングサーバー（server/index.ts） ----
PORT=8787
HOST=0.0.0.0
# SQLiteファイルの保存先（永続ディスク上に置く）
DB_PATH=data/tamago.sqlite
# フロントエンドを別オリジンで配信する場合、そのオリジンをカンマ区切りで
ALLOWED_ORIGINS=
# ビルド済みフロントエンドを同じサーバーで配信する場合（例: dist）
STATIC_DIR=
# 運営用トークン（不適切な名前の非表示に使用）。長いランダム文字列にし、サーバーだけに置く
ADMIN_TOKEN=
# runの有効期限（分）
RUN_TTL_MINUTES=15
# 調理時間と実経過時間の許容差（ミリ秒）
ELAPSED_TOLERANCE_MS=3000
# 操作ログの保持日数
EVENTS_RETENTION_DAYS=30
# リバースプロキシ配下で X-Forwarded-For を信頼する場合は 1
TRUST_PROXY=0
